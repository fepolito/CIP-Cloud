# ═══════════════════════════════════════════════════════════════
# CIP Cloud — .htaccess raiz (segurança + roteamento)
# ───────────────────────────────────────────────────────────────
# @arquivo       .htaccess
# @versao        2.0.0
# @modificado_em 2026-06-09
# @objetivo      Blindagem de arquivos sensíveis + headers de
#                segurança para o doc_root público.
# ═══════════════════════════════════════════════════════════════

# ── Charset e options ──
AddDefaultCharset UTF-8
Options -Indexes -ExecCGI
ServerSignature Off

# ── Bloqueio: metadados Git ──
RedirectMatch 404 /\.git
<DirectoryMatch "^\.git">
    Require all denied
</DirectoryMatch>
<FilesMatch "^\.git">
    Require all denied
</FilesMatch>

# ── Bloqueio: arquivos de deploy / config ──
<FilesMatch "^(\.cpanel\.yml|\.gitignore|\.gitattributes|\.env.*|composer\.(json|lock)|package(-lock)?\.json|README\.md|CHANGELOG\.md)$">
    Require all denied
</FilesMatch>

# ── Bloqueio: scripts DEV-only (caso vazem) ──
<FilesMatch "\.(bat|ps1|sh|sql|bak|swp|tmp|log)$">
    Require all denied
</FilesMatch>

# ── Bloqueio: auditorias e arquivos ad-hoc ──
<FilesMatch "^_audit_">
    Require all denied
</FilesMatch>

# ── Bloqueio: pastas internas (defesa em profundidade) ──
RedirectMatch 404 /(app|config|includes|storage|database|tools|tests|docs)(/.*)?$

# ── Headers de segurança ──
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # HSTS (somente PROD com HTTPS confirmado)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ── Compressão (performance) ──
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
</IfModule>

# ── Cache de estáticos (performance) ──
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

# ── PHP: forçar UTF-8 e timezone (HostGator) ──
<IfModule mod_php.c>
    php_value default_charset "UTF-8"
    php_value date.timezone "UTC"
</IfModule>
